# Career Coach Agent v2 — environment template.
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`
# (it is git-ignored). In HF Spaces, set these via the Space Secrets panel.
#
# Variables consumed by docker-compose.yml interpolation and/or backend config
# (backend/app/config.py).

# --- Postgres (compose builds DATABASE_URL from these) -----------------------
POSTGRES_USER=career_coach
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=career_coach

# DATABASE_URL and REDIS_URL are assembled by docker-compose from the values
# above and the in-network service hostnames (db / redis). Override them only
# if you run the backend outside compose, e.g.:
# DATABASE_URL=postgresql+asyncpg://career_coach:change_me_local_dev@localhost:5432/career_coach
# REDIS_URL=redis://localhost:6379/0

# --- LLM / HuggingFace Inference (required) ----------------------------------
HF_API_TOKEN=hf_your_token_here

# --- Auth / session JWT (required) -------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_generate_a_long_random_secret

# --- SSO (OIDC): Google + LinkedIn — see docs/oauth-setup.md -----------------
# Client id/secret come from the Google Cloud / LinkedIn Developer consoles.
# Leave blank to disable a provider locally; login will 502 until configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public base URL of THIS backend (scheme + host, no trailing slash). The OIDC
# callback URI is derived as <base>/api/auth/callback/{provider} and MUST match
# the redirect URI registered in each provider console. In HF Spaces set this to
# the Space domain, e.g. https://<owner>-<space>.hf.space
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Frontend URL the browser lands on after a successful login. The session token
# is appended in the URL fragment (#access_token=...) for the SPA to read.
OAUTH_POST_LOGIN_REDIRECT=http://localhost:3000/auth/callback

# --- External job/search APIs — optional -------------------------------------
SERPAPI_API_KEY=
RAPID_API_KEY=

# --- App behaviour — optional (defaults live in config.py) -------------------
DEBUG=false

# --- Frontend → backend proxy (docker-compose only; informational) -----------
# The Next.js server reverse-proxies same-origin /api/* browser calls to the
# backend (frontend/lib/apiProxy.ts), so the browser only ever talks to :3000
# (no CORS). The backend host is baked into the frontend build via the
# INTERNAL_API_URL Docker *build arg* — docker-compose.yml already sets it to
# http://backend:8000. It is NOT read from this .env (Next freezes rewrites() at
# build time), so overriding it here has no effect; change it in
# docker-compose.yml's frontend `build.args` if you relocate the backend.
