# Career Coach Agent v2 — environment template.
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`
# (it is git-ignored). In HF Spaces, set these via the Space Secrets panel.
#
# Variables consumed by docker-compose.yml interpolation and/or backend config
# (backend/app/config.py).

# --- Postgres (compose builds DATABASE_URL from these) -----------------------
POSTGRES_USER=career_coach
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=career_coach

# DATABASE_URL and REDIS_URL are assembled by docker-compose from the values
# above and the in-network service hostnames (db / redis). Override them only
# if you run the backend outside compose, e.g.:
# DATABASE_URL=postgresql+asyncpg://career_coach:change_me_local_dev@localhost:5432/career_coach
# REDIS_URL=redis://localhost:6379/0

# --- LLM / HuggingFace Inference (required) ----------------------------------
HF_API_TOKEN=hf_your_token_here

# --- Auth / session JWT (required) -------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_generate_a_long_random_secret

# --- SSO (OIDC) — optional until P3 ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- External job/search APIs — optional -------------------------------------
SERPAPI_API_KEY=
RAPID_API_KEY=

# --- App behaviour — optional (defaults live in config.py) -------------------
DEBUG=false
